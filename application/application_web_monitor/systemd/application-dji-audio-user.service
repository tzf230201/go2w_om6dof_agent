[Unit]
Description=DJI Wireless Mic bridge — AGX application server
After=network-online.target pulseaudio.service pipewire.service
Wants=network-online.target pulseaudio.service

[Service]
Type=simple
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /home/kublab/unitree_ros2/setup.sh; source /home/kublab/ros2_ws/install/setup.bash; exec ros2 run application_web_monitor dji_audio_bridge'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
