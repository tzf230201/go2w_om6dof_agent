[Unit]
Description=OM6DOF Web Monitor — AGX standalone LAN dashboard
After=network-online.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=kublab
Group=kublab
Environment=HOME=/home/kublab
# OM6DOF is local on the AGX. Go2W remains on the NX and is intentionally not
# required by this service.
ExecStart=/bin/bash -c 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 run application_web_monitor web_monitor --ros-args -p go2w_enabled:=false'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
