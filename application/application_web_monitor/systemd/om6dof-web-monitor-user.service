[Unit]
Description=OM6DOF Web Monitor — AGX standalone application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /opt/ros/humble/setup.bash; source /home/kublab/ros2_ws/install/setup.bash; unset CYCLONEDDS_URI; exec ros2 run application_web_monitor web_monitor --ros-args -p go2w_enabled:=false'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
