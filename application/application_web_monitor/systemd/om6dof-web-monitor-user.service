[Unit]
Description=Go2W Web Monitor — AGX application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /home/kublab/unitree_ros2/setup.sh; source /home/kublab/ros2_ws/install/setup.bash; exec ros2 run application_web_monitor web_monitor --ros-args -p robot_ssh_host:=unitree@192.168.123.18'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
