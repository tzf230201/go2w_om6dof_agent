[Unit]
Description=Unitree microphone speech-to-text — AGX application server
After=network-online.target whisper-stt-server.service application-audio-bridge.service
Wants=network-online.target whisper-stt-server.service application-audio-bridge.service

[Service]
Type=simple
Environment=HOME=/home/kublab
ExecStart=/bin/bash -c 'set -e; source /home/kublab/unitree_ros2/setup.sh; source /home/kublab/ros2_ws/install/setup.bash; exec ros2 run application_web_monitor unitree_stt'
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
